<?xml version="1.0" encoding="UTF-8"?>
<pgeConfig>

  <!-- The join. Every row gets its translatable cells replaced from the
       lookup the translate stage built, and the document is posted. No
       model is involved: this is a dict lookup repeated 836 million times.
       Solr takes about 35,000 documents a second, so the shards overlap
       reading the corpus with posting rather than pushing Solr harder. -->
  <exe dir="[JobDir]" shell="bash">
     <cmd>export PYTHONIOENCODING=utf-8</cmd>
     <cmd>mkdir -p "[JobOutputDir]" "[JobLogDir]"</cmd>
     <!-- Every shard, from this one instance. JoinShards said eight and
          only shard zero ever ran, because nothing created instances for
          the other seven: a corpus was indexed one eighth of the way and
          reported success. Running them here keeps the parallelism without
          needing an instance apiece. -->
     <!-- How many chunks there are to wait for, counted from the chunk
          repository rather than guessed. The settled condition stops the
          join beginning absurdly early; this stops it beginning early at
          all. -->
     <!-- EXPECTED first, then the database, then the join.
          
          The database used to be built before the count was even taken, so
          it was built from whatever had arrived and the join's own expect
          wait came afterwards. On a 458 chunk run that meant a database
          built at 16:16 from 442 chunks and a join starting at 16:36 with
          all 458 present: every document indexed, and 155,000 strings left
          in Spanish, reported as success. The wait belongs on the step that
          decides what can be translated. -->
     <!-- One database for every shard to share. Read as JSON each shard
          holds its own 456MB copy of the same table, and eight of those is
          what put the machine over during the first full run. -->
     <cmd>EXPECTED=$(ls -d "[StringsDir]"/chunk-*.json 2>/dev/null | wc -l | tr -d " ")</cmd>
     <cmd>"[BIGTRANSLATE_HOME]/bin/bt-build-translation-db" --translated "[TranslatedDir]" --glossary "[TranslateGlossary]" --out "[TranslationsDb]" --expect $EXPECTED [GreaterThan][GreaterThan] "[JobLogDir]/join_[DateMilis].log" 2[GreaterThan][Ampersand]1</cmd>
     <!-- Each shard is waited on by pid, and a failure in any of them fails
          this command.

          It ends with "test", not "exit". Every cmd in this file is
          concatenated into one script, so "exit 0" ended the whole script and
          the three commands after this one never ran: the commit only pass,
          the marker clear, and join.done. On the 2026-09-28 join that left
          119,453,210 documents written to the index and never committed, so
          Solr answered 0 to every query, and the script had exited 0 so the
          PGE recorded Success. The data was intact and invisible.

          The script is run under "set -e", so a command that returns non-zero
          stops it. Ending on "test $rc -eq 0" is therefore all that is needed
          to fail the task, and it stops this one command rather than the file.

          "test" rather than "[" for the same reason on a different axis:
          PathUtils treats [...] as a metadata reference, so "[ $rc -ne 0 ]"
          was logged as an unresolved [Name] on every run. It happened to work,
          because an unresolved reference is left as written.

          A bare "wait" returns 0 whatever the background jobs did, so shard
          failures were invisible. On the 2026-09-27 run all four exited
          immediately on an unsubstituted [CorpusDir]; the commit only pass
          below then committed an empty index, the run marker was cleared, and
          the workflow recorded Success. Solr held 0 documents at the end of a
          run whose 2,286,244 translations were all present.

          Failing here is what keeps the two commands after this one from
          running: a marker cleared on a failed join is a run that reports
          itself finished. -->
     <cmd>pids=""; for s in $(seq 0 $(([JoinShards] - 1))); do "[BIGTRANSLATE_HOME]/bin/bt-join-index" --corpus "[CorpusDir]" --translated "[TranslatedDir]" --translations-db "[TranslationsDb]" --solr-url "[SolrUrl]" --colheaders "[ColHeaders]" --encodings "[Encodings]" --translate-cols "[TranslateCols]" --shard $s --of [JoinShards] --expect $EXPECTED [GreaterThan][GreaterThan] "[JobLogDir]/join_[DateMilis].log" 2[GreaterThan][Ampersand]1 [Ampersand] pids="$pids $!"; done; rc=0; for p in $pids; do wait $p || rc=1; done; if test $rc -ne 0; then echo "a join shard failed; see [JobLogDir]/join_[DateMilis].log" [GreaterThan][Ampersand]2; fi; test $rc -eq 0</cmd>
     <cmd>"[BIGTRANSLATE_HOME]/bin/bt-join-index" --corpus "[CorpusDir]" --translated "[TranslatedDir]" --translations-db "[TranslationsDb]" --solr-url "[SolrUrl]" --colheaders "[ColHeaders]" --encodings "[Encodings]" --translate-cols "[TranslateCols]" --shard 0 --of [JoinShards] --commit-only [GreaterThan][GreaterThan] "[JobLogDir]/join_[DateMilis].log" 2[GreaterThan][Ampersand]1</cmd>
     <!-- Prove the index holds what was posted, before anything says the run
          is over.
 
          Three runs in a row reported Success having produced an index nobody
          could query, and no single cheap check would have caught all of them:
          one indexed nothing, one indexed everything and committed none of it,
          and the document count is the corpus size restated either way, so it
          cannot tell a good run from a bad one.
 
          What it can tell is whether the join committed. The verify-only mode requires
          every shard to have finished and reported what it put in, requires the
          total to be non-zero, and requires Solr to agree with it. Placed after
          the commit and before the marker clear, so under set -e a failure
          leaves the run marker standing and the task failed, rather than a
          finished-looking run over an empty index. -->
     <cmd>"[BIGTRANSLATE_HOME]/bin/bt-join-index" --corpus "[CorpusDir]" --translated "[TranslatedDir]" --translations-db "[TranslationsDb]" --solr-url "[SolrUrl]" --colheaders "[ColHeaders]" --encodings "[Encodings]" --translate-cols "[TranslateCols]" --of [JoinShards] --verify-only [GreaterThan][GreaterThan] "[JobLogDir]/join_[DateMilis].log" 2[GreaterThan][Ampersand]1</cmd>
     <cmd>"[BIGTRANSLATE_HOME]/bin/bt-run-marker" clear</cmd>
     <cmd>echo "[JoinShards] shards indexed" [GreaterThan] "[JobOutputDir]/join.done"</cmd>
  </exe>

  <!-- Nothing to ingest. The documents are in Solr; the shard marker is for
       the log, not the catalog. -->
  <output>
  </output>

  <customMetadata>
    <metadata key="LessThan" val="&#x3C;"/>
    <metadata key="GreaterThan" val="&#x3E;"/>
    <metadata key="Exclamation" val="&#33;"/>
    <metadata key="Ampersand" val="&#38;"/>
    <metadata key="ProductionDateTime" val="[DATE.UTC]"/>
    <metadata key="DateMilis" val="[DATE_TO_MILLIS([ProductionDateTime],UTC_FORMAT,1970-01-01)]"/>
    <metadata key="ShardIndex" val="0"/>
    <metadata key="TranslationsDb" val="[BIGTRANSLATE_HOME]/data/translations.sqlite"/>
    <metadata key="StringsDir" val="[BIGTRANSLATE_HOME]/data/strings"/>
    <metadata key="JobDir" val="[BIGTRANSLATE_HOME]/data/jobs/join/[ShardIndex]_[DateMilis]"/>
    <metadata key="JobOutputDir" val="[JobDir]/output"/>
    <metadata key="JobLogDir" val="[JobDir]/logs"/>
  </customMetadata>
</pgeConfig>
