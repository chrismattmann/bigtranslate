<!--
  The employment posting a BigTranslate run produces, after tsvtojson,
  repackage and Pantogloss have been over it.

  The previous schema carried 64 field types from Solr's example, of which
  four were used. date became pdate and long became plong: Solr removed the
  Trie types those resolved to. SynonymFilterFactory became
  SynonymGraphFilterFactory, and enablePositionIncrements went away in Solr 7.

  Most fields are required. That is deliberate and predates this change: a
  posting missing its title or its coordinates is not worth indexing.
-->
<schema name="bigtranslate" version="1.6">

  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>

  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="stop" ignoreCase="true" words="stopwords.txt"/>
      <filter name="lowercase"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="stop" ignoreCase="true" words="stopwords.txt"/>
      <filter name="synonymGraph" synonyms="synonyms.txt" ignoreCase="true" expand="true"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>

  <!-- leading-wildcard search, which is what text_rev below exists for -->
  <fieldType name="text_general_rev" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="stop" ignoreCase="true" words="stopwords.txt"/>
      <filter name="lowercase"/>
      <filter name="reversedWildcard" withOriginal="true"
              maxPosAsterisk="3" maxPosQuestion="2" maxFractionAsterisk="0.33"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="synonymGraph" synonyms="synonyms.txt" ignoreCase="true" expand="true"/>
      <filter name="stop" ignoreCase="true" words="stopwords.txt"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>

  <field name="id" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="postedDate" type="pdate" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="department" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="title" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="salary" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="start" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="duration" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="jobtype" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="applications" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="company" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="contactPerson" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="phoneNumber" type="string" indexed="true" stored="true" required="false" multiValued="false"/>
  <field name="faxNumber" type="string" indexed="true" stored="true" required="false" multiValued="false"/>
  <field name="location" type="string" indexed="true" stored="true" required="false" multiValued="false"/>
  <field name="latitude" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="longitude" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="firstSeenDate" type="pdate" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="url" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="lastSeenDate" type="pdate" indexed="true" stored="true" required="true" multiValued="false"/>

  <field name="content" type="text_general" indexed="false" stored="true" multiValued="true"/>
  <field name="text" type="text_general" indexed="true" stored="false" multiValued="true"/>
  <field name="text_rev" type="text_general_rev" indexed="true" stored="false" multiValued="true"/>

  <field name="_version_" type="plong" indexed="false" stored="false" docValues="true"/>

  <!-- anything the pipeline emits that is not named above is still searchable -->
  <dynamicField name="*" type="string" indexed="true" stored="true" omitNorms="true" multiValued="true"/>

  <copyField source="*" dest="text"/>
  <copyField source="*" dest="text_rev"/>

  <uniqueKey>id</uniqueKey>

</schema>
