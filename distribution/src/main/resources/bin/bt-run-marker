"""Record that a run is happening, for anything that wants to show it.

bin/bigtranslate writes this marker for a run it starts itself. A run the
engine drives has no such caller: the stages are started by events, and
Gloss reported IDLE for the whole of one because nothing had written the
file. So the stages write it too -- extract begins it, each translated
chunk beats it, and the join clears it.

The beat is what separates a run from the wreckage of one. Without it a
marker is only evidence that something once started, and a run that died
leaves Gloss reporting a translation in progress until somebody notices.
"""
import argparse
import glob
import json
import os
import sys
import time


def marker_path():
    home = os.environ.get("BIGTRANSLATE_HOME")
    if not home:
        return None
    return os.path.join(home, "data", "run")


def cleared_path():
    """Where "this run is over" is recorded.

    A beat rebuilds a marker that has gone missing, which is right while a
    run is going -- Gloss deletes the marker whenever the heartbeat goes
    quiet, and the extract pass guarantees that on any corpus big enough to
    take longer than the stale bound to read.

    It is wrong once a run has ended. The join clears the marker as its last
    act, and the wait loop in bin/bigtranslate, which is still up and still
    beating, put it back fifteen seconds later: Gloss went on showing a
    finished run as in progress -- 458 of 458 chunks and the full document
    count sitting under a progress bar -- until the loop happened to notice
    the workflow manager was quiet and exited. On run 6 that was two minutes
    and forty seconds.

    So a clear leaves this behind, and a beat will not rebuild across it. A
    start removes it, because a new run supersedes the last one's ending.
    """
    path = marker_path()
    return path + ".done" if path else None


def read(path):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except Exception:
        return {}


def names(directory):
    """The chunks in a directory, however the versioner left them.

    The ingest nests each product under a directory named after it, so the
    chunks the join reads are files and the catalogued copies are
    directories. Both count as one chunk.
    """
    try:
        return {n for n in os.listdir(directory) if n.startswith("chunk-")}
    except OSError:
        return set()


def count(directory):
    return len(names(directory))


def earliest(directory):
    """When the first chunk in a directory appeared, in epoch millis.

    Used only when a marker has to be rebuilt and its original start time is
    gone. Guessing "now" instead would date a run that is hours old to this
    second, and a rate worked out from it -- a hundred chunks in no time at
    all -- would be nonsense in the direction that looks like good news.
    """
    try:
        names = [n for n in os.listdir(directory) if n.startswith("chunk-")]
    except OSError:
        return None
    stamps = []
    for name in names:
        try:
            stamps.append(os.path.getmtime(os.path.join(directory, name)))
        except OSError:
            continue
    return int(min(stamps) * 1000) if stamps else None


def chunk_weights(home):
    """What each chunk costs, keyed by name.

    Chunks are equal in count and wildly unequal in work, because the
    extract sorts every distinct string by length before cutting them up:
    the first chunk holds 5,000 strings averaging four characters, the last
    holds paragraphs averaging 254. Counting chunks therefore says a run is
    half finished when less than a third of the text has been through the
    model, and the estimate built on it was out by a factor of two and a
    half on a measured run.

    The extract writes the weights into its manifest. A run that started
    before it did has none, so the midpoint of the length range stands in --
    a chunk's strings are nearly all the same length, which is the whole
    point of sorting them, so that is close enough to be worth having.
    """
    pattern = os.path.join(home, "data", "jobs", "extract", "*", "output",
                           "manifest.json")
    files = sorted(glob.glob(pattern), key=os.path.getmtime, reverse=True)
    for path in files:
        try:
            with open(path, encoding="utf-8") as handle:
                chunks = json.load(handle).get("chunks") or []
        except Exception:
            continue
        weights = {}
        for entry in chunks:
            name = entry.get("chunk")
            if not name:
                continue
            chars = entry.get("chars")
            if chars is None:
                lo = entry.get("min_length") or 0
                hi = entry.get("max_length") or lo
                chars = int(entry.get("count") or 0) * (lo + hi) / 2.0
            weights[name] = float(chars)
        if weights:
            return weights
    return {}


def progress(home):
    """What the run has done so far, for anything that wants to show it.

    Read from the directories rather than tracked, so it is right even
    after a restart and cannot drift from what is actually on disk.
    """
    made = count(os.path.join(home, "data", "strings"))
    # Every node that translates a chunk writes it into its own flat
    # directory and the File Manager brings it back to the archive, so on a
    # distributed run the archive is the only complete copy -- the manager's
    # flat directory holds just the share it translated itself. Counting
    # that alone reported 43 of 458 while 121 were done, which understates
    # the rate by the same factor and makes the estimate of when the run
    # ends useless. It also meant done never reached made, so the stage
    # never turned over to joining.
    #
    # The union rather than either one: a chunk that exists anywhere has an
    # answer, and a single machine install has no archive at all.
    done = len(names(os.path.join(home, "data", "translated"))
               | names(os.path.join(home, "data", "translated-catalog")))
    if done >= made > 0:
        stage = "joining"
    elif made > 0:
        stage = "translating"
    else:
        stage = "extracting"
    state = {"stage": stage, "chunksTotal": made, "chunksDone": done}
    # How much of the text has actually been through the model, as opposed
    # to how many chunks have been ticked off.
    weights = chunk_weights(home)
    if weights:
        finished = names(os.path.join(home, "data", "translated")) | names(
            os.path.join(home, "data", "translated-catalog"))
        state["weightTotal"] = round(sum(weights.values()))
        state["weightDone"] = round(
            sum(w for name, w in weights.items() if name in finished))
    return state


def with_file_progress(state, existing, done, total):
    """Carry how far the read has got, while it is the read that is running.

    Everything else here is counted off the disk, because a directory cannot
    drift from itself. The extract has nothing to count: no chunk exists
    until the whole corpus has been read, which is the longest stretch of a
    run and the one with no bar. So this one number is reported rather than
    derived, and only while it is true -- once a chunk exists the stage is
    translating and the chunk counts take over.
    """
    if state.get("stage") != "extracting":
        return state
    if done is None:
        done = existing.get("filesDone")
        total = existing.get("filesTotal")
    if done is not None:
        state["filesDone"] = int(done)
        state["filesTotal"] = int(total or 0)
    return state


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="bt-run-marker",
        description="Write, refresh or clear the marker that says a run is "
                    "in progress.")
    parser.add_argument("action", choices=["start", "beat", "clear"])
    parser.add_argument("--status", default="TRANSLATING")
    parser.add_argument("--path", default="")
    parser.add_argument("--started-by", default="workflow")
    # The crawl's exclude regex. It contains backslashes -- the default is
    # .*/\.[^/]*(/.*)? -- and it used to be written into the marker by a
    # printf in bin/bigtranslate that escaped nothing. "\." is not a valid
    # JSON escape, so the file this writes and reads stopped parsing: every
    # beat found no marker, rebuilt one from scratch, and lost the corpus
    # path and the real start time with it. json.dump escapes it.
    parser.add_argument("--exclude", default=None)
    # How far the corpus read has got. Only the extract passes these, and
    # only so that "Reading the corpus" can show a bar rather than a log.
    parser.add_argument("--files-done", type=int, default=None)
    parser.add_argument("--files-total", type=int, default=None)
    args = parser.parse_args(argv)

    path = marker_path()
    if not path:
        # Not being able to say so is not worth failing a stage over.
        sys.stderr.write("BIGTRANSLATE_HOME unset; not recording the run\n")
        return 0

    if args.action == "clear":
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        except OSError as e:
            sys.stderr.write("could not clear the run marker: %s\n" % e)
        # Before anything else can beat. See cleared_path().
        done = cleared_path()
        if done:
            try:
                os.makedirs(os.path.dirname(done), exist_ok=True)
                with open(done, "w", encoding="utf-8") as handle:
                    json.dump({"clearedAt": int(time.time() * 1000)}, handle)
            except OSError as e:
                sys.stderr.write("could not record the end of the run: %s\n" % e)
        return 0

    now = int(time.time() * 1000)
    existing = read(path) if args.action == "beat" else {}

    home = os.environ["BIGTRANSLATE_HOME"]
    seen = with_file_progress(progress(home), existing,
                              args.files_done, args.files_total)

    # A beat used to be refused when no marker was there to refresh, on the
    # grounds that a beat is not a reason to invent a run. It is exactly
    # that: only a stage of a run calls this, so a beat is a stage saying it
    # is working. Refusing left a run that lost its marker unable to get one
    # back, and the marker is lost routinely -- Gloss deletes it whenever
    # the heartbeat goes quiet, which the extract pass guarantees on any
    # corpus big enough to take longer than the stale bound to read.
    done = cleared_path()
    if args.action == "start":
        # A new run supersedes the last one's ending.
        try:
            os.remove(done)
        except (OSError, TypeError):
            pass
    elif done and not existing and os.path.exists(done):
        # The run this would be rebuilding is over. Saying so is the whole
        # point: without it the caller cannot tell "no marker yet" from
        # "no marker any more".
        sys.stderr.write("the run is over; not rebuilding the marker\n")
        return 0

    rebuilt = args.action == "beat" and not existing

    record = {
        "status": existing.get("status", args.status),
        "startedBy": existing.get("startedBy", args.started_by),
        "path": existing.get("path", args.path) if args.action == "beat"
                else args.path,
        "exclude": (existing.get("exclude", "") if args.exclude is None
                    else args.exclude),
        "startedAt": existing.get("startedAt", now),
        "heartbeatAt": now,
    }
    if rebuilt:
        # Date it from the work on disk, not from this moment.
        record["startedAt"] = (earliest(os.path.join(home, "data", "strings"))
                               or now)
        record["rebuiltAt"] = now
    record.update(seen)
    # When the first chunk landed, so a rate can be worked out over the
    # translating alone. Measuring from the start of the run instead folds
    # in the extract pass, which on the full corpus is ten minutes of
    # apparently translating nothing and makes every early estimate wrong.
    if seen["chunksDone"] > 0:
        # On a rebuild there is no remembered value, and taking "now" would
        # divide every chunk already translated by no elapsed time at all.
        fallback = earliest(os.path.join(home, "data", "translated")) or now
        record["translatingSince"] = existing.get("translatingSince", fallback)
    elif "translatingSince" in existing:
        record["translatingSince"] = existing["translatingSince"]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".partial"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(record, handle)
    os.replace(tmp, path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
