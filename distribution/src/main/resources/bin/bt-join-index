"""Apply the translations back to every row, and index the result.

The translate stage produced one answer per distinct string. This stage is
the join: it streams the corpus, substitutes the translation for each
translatable cell, and posts the documents to Solr. No model is involved
and none is needed -- three hundred million cells are looked up in a dict.

Records are not lines. Titles in this corpus contain embedded newlines, so
a record is accumulated until it has as many columns as the headers
describe. Splitting on newlines instead mangles every row after the first
such title, which is the kind of error that indexes cleanly and is only
noticed much later.
"""
import argparse
import glob
import json
import os
import re
import sys
import sqlite3
import subprocess
import time
import unicodedata
import urllib.error
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bt_encoding  # after the path insert above, which makes it importable


def log(message):
    sys.stderr.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), message))
    sys.stderr.flush()


def read_columns(path):
    """Column names, one per line. Blank lines and # comments are skipped.

    Must agree with bt-extract-strings: extract decides which columns are
    collected and this decides which are substituted back, so a file the two
    read differently translates a column nobody puts back, or puts back one
    nobody translated.
    """
    with open(path, encoding="utf-8") as handle:
        return [line.strip() for line in handle
                if line.strip() and not line.lstrip().startswith("#")]


class Translations(object):
    """The translation table, shared rather than copied.

    Read as JSON into a dict it is about 456MB, and every shard holds its
    own: eight of them is three and a half gigabytes of the same data, and
    that is what put a machine over during the first full run. Backed by a
    database instead, the pages are held once by the operating system
    however many shards are reading.

    A bounded cache sits in front. The corpus repeats itself heavily -- 836
    million cells are only 2.29 million distinct strings -- so a small cache
    answers nearly everything and the database sees very little traffic.
    """

    def __init__(self, path, cache_limit=200000):
        # Read only, so several shards can share one file without any of
        # them being able to alter it.
        self.conn = sqlite3.connect("file:%s?mode=ro" % path, uri=True)
        self.conn.execute("PRAGMA query_only = 1")
        self.cache = {}
        self.cache_limit = cache_limit
        self.hits = 0
        self.misses = 0

    def get(self, source, default=None):
        cached = self.cache.get(source)
        if cached is not None:
            self.hits += 1
            return cached
        self.misses += 1
        row = self.conn.execute(
            "SELECT e FROM t WHERE s = ?", (source,)).fetchone()
        if row is None:
            return default
        if len(self.cache) < self.cache_limit:
            # Not an LRU. Evicting properly costs more than it saves here,
            # and what fills the cache first is what the corpus repeats
            # most, which is what a cache is for.
            self.cache[source] = row[0]
        return row[0]

    def count(self):
        return self.conn.execute("SELECT count(*) FROM t").fetchone()[0]

    def close(self):
        try:
            self.conn.close()
        except Exception:
            pass


def records(path, columns, encodings=bt_encoding.DEFAULT_ENCODINGS):
    """Yield complete records, rejoining rows split by embedded newlines.

    Read as bytes and decoded a line at a time: the corpus is not all UTF-8,
    and decoding the whole file as UTF-8 with replacement turned every
    latin-1 accent into U+FFFD on the way to Solr.
    """
    wanted = len(columns)
    pending = ""
    for line in bt_encoding.lines(path, encodings):
        pending = pending + line if pending else line
        parts = pending.rstrip("\n").split("\t")
        if len(parts) >= wanted:
            yield parts
            pending = ""
    if pending.strip():
        parts = pending.rstrip("\n").split("\t")
        if len(parts) >= wanted:
            yield parts


def chunk_files(directory):
    """Every translated chunk under directory, however it is laid out.

    The join reads the File Manager's archive rather than the flat directory a
    translate task writes into, because the flat directory only ever holds the
    chunks translated on that particular machine. On a two node run the
    manager had 9 of 62 and the other 53 sat on the compute node, so a join
    reading the flat directory would have indexed a seventh of the corpus and
    reported success.

    The archive is complete, because remote data transfer brings every node's
    output back to it, but BasicVersioner lays it out as <name>/<name>. Both
    shapes are accepted so that a single machine deployment, where the flat
    directory is complete, keeps working unchanged.
    """
    flat = [path for path in glob.glob(os.path.join(directory, "chunk-*.json"))
            if os.path.isfile(path)]
    archived = glob.glob(
        os.path.join(directory, "chunk-*.json", "chunk-*.json"))
    return sorted(set(flat) | set(archived))


def count_chunks(directory):
    return len(chunk_files(directory))


def wait_for_chunks(directory, expected, timeout, poll=15):
    """A backstop. The workflow gate is what actually holds the join back.

    `TranslationsSettled` (ProductCountMatchesCondition) will not let this
    task start until catalogued EmploymentTranslatedChunk products equal
    catalogued EmploymentStringChunk products, so by the time we run here
    every chunk should already be on disk and the first count should be the
    only count.

    It is kept because it checks a different fact. The condition counts
    products in the catalogue; this counts files in a directory. A chunk can
    be catalogued on one node and not yet visible on the one running the
    join, and indexing that gap produces the worst possible outcome: every
    document present, some of them still in Spanish, and a run that reports
    success.

    So if this ever has to wait, the gate let the task through early. Say so
    rather than absorbing it quietly.

    Chunks are written to a temporary name and renamed, so one that exists
    is one that is finished; counting them is enough.
    """
    started = time.time()
    seen = count_chunks(directory)
    if seen < expected:
        log("  WARNING: %d of %d translated chunks on disk. TranslationsSettled "
            "should have held this task until all %d were catalogued, so the "
            "gate passed early or the files have not landed on this node."
            % (seen, expected, expected))
    while seen < expected and time.time() - started < timeout:
        log("  waiting: %d of %d chunks translated" % (seen, expected))
        time.sleep(poll)
        seen = count_chunks(directory)
    return seen


def as_solr_date(value):
    """Solr's pdate wants a full instant; the corpus carries plain dates.

    Not all of them are zero-padded: 36% of postedDate in this corpus reads
    "2012-11-6" rather than "2012-11-06". Matching on length alone rejects
    those, and because postedDate is a required field the whole record is
    then dropped -- a third of the corpus, silently, with a clean index at
    the end of it to suggest nothing went wrong.
    """
    value = (value or "").strip()
    parts = value.split("-")
    if len(parts) != 3:
        return None
    year, month, day = parts
    if not (year.isdigit() and month.isdigit() and day.isdigit()):
        return None
    if len(year) != 4:
        return None
    try:
        if not (1 <= int(month) <= 12 and 1 <= int(day) <= 31):
            return None
    except ValueError:
        return None
    return "%s-%02d-%02dT00:00:00Z" % (year, int(month), int(day))


def build_document(parts, columns, translate_at, table, required, dates,
                   identifier):
    """One Solr document from one record.

    Translatable cells are replaced by their translation where one exists.
    A missing translation leaves the original in place rather than dropping
    the field: an untranslated Spanish title is worth more than no title,
    and it is visible in the index rather than silently absent.
    """
    document = {"id": identifier}
    for index, name in enumerate(columns):
        if index >= len(parts):
            continue
        value = parts[index].strip()
        if not value:
            continue
        if index in translate_at:
            value = table.get(value, value)
        document[name] = value[:32000]
    for name in dates:
        stamped = as_solr_date(document.get(name))
        if stamped:
            document[name] = stamped
        else:
            document.pop(name, None)
    # Solr's "required" means present, not non-empty, and the corpus leaves
    # cells blank routinely: contactPerson is absent from 4% of records and
    # latitude from 1%. Dropping those would lose one record in twenty for
    # want of a contact name, so a blank is carried through as a blank --
    # which is what the corpus actually says.
    #
    # A required date is different. It cannot be blank and still parse as a
    # pdate, and a posting with no readable date is not a posting we can
    # place in time, so that record is genuinely dropped.
    for name in required:
        if name not in document and name not in dates:
            document[name] = ""
    add_numeric_coordinates(document)
    add_country(document)
    add_numeric_salary(document)
    missing = [name for name in required if name not in document]
    return document, missing


# Salaries are written the way the country writes them, and the corpus spans
# four of them. "800.000" is eight hundred thousand Colombian pesos, not eight
# hundred; "10,000" is ten thousand. A dot and a comma are both thousands
# separators here, never a decimal point: these are monthly salaries in whole
# currency units, and nobody advertises 1.5 pesos.
#
# The apostrophe is a separator too, and a Colombian one: $1'700,000 is one
# million seven hundred thousand pesos. Read as two numbers it becomes 1 and
# 700,000, the 1 falls below the floor as noise, and the salary is stored as
# 700,000 -- understated by a factor of two and a half, silently, on 403,182
# postings. Folded in with the dot and the comma so the whole figure survives.
_SALARY_JUNK = re.compile(r"[^0-9.,'\u2019\-]")
_SALARY_NUMBER = re.compile(r"\d+(?:[.,'\u2019]\d{3})*")
_SALARY_APOSTROPHE = re.compile(r"\d\s*['\u2019]\s*\d")
_SALARY_RUN = re.compile(r"\d[\d.,'\u2019 ]*\d")

# Above this nothing is a monthly salary in any of the four currencies, and
# below it nothing is either. The corpus reaches into the millions because a
# Colombian salary is quoted in pesos, so the ceiling has to be generous; the
# floor exists because "0" is how this corpus writes "not stated" and is the
# fourth most common value in the column, 417,082 records of it.
# The floor is not cosmetic. "Table 1" is what the model made of a salary
# cell in one country-day, and a bare "1" parsed out of it is a salary of one
# peso; "2,5" parses to two numbers and, read as a range, to 3.5. Nothing in
# any of these four currencies pays a monthly wage below three figures -- the
# Peruvian minimum wage in 2013 was 750 soles -- so anything under a hundred
# is a mistranslation, a count, or a footnote marker.
SALARY_FLOOR = 100.0
SALARY_CEILING = 100000000.0

# What separates the two halves of a range. Without this, any cell holding
# two numbers for unrelated reasons is averaged into one that means nothing.
_SALARY_RANGE = re.compile(r"\d\s*(?:-|–|—|\bto\b|\ba\b|\by\b)\s*[$\s]*\d")


def parse_salary(raw):
    """A number from a salary cell, or None when there is not one in it.

    Most of the column is not a number at all. "To be agreed" is 15,276,117
    records, "In an interview" 3,682,013, "Negotiable" 908,564. About 8.9% of
    the corpus states a figure, which is 10.6 million records -- enough to
    answer the question, and only if the ones that do not are left out rather
    than counted as zero.
    """
    if raw is None:
        return None
    text = str(raw)
    # Colombian notation is written loosely: "$1'700,000", "$ 1' 000.000",
    # "$1 '700,000" and "$ 1'000 000" all appear, and all of them mean one
    # point something million pesos. Close the gaps around the separators
    # before anything tries to read the number, or the leading digit comes
    # off as its own value, falls below the floor as noise, and the salary is
    # stored as the remainder -- 700,000 for 1,700,000, on 403,182 postings.
    if _SALARY_APOSTROPHE.search(text):
        # One figure, however it was spaced. Only the run of digits and
        # separators around the apostrophe is collapsed, so a range like
        # "12000 - 13000" elsewhere in the cell is untouched: the dash is
        # not in the class and stops the match.
        text = _SALARY_RUN.sub(
            lambda m: re.sub(r"[^0-9]", "", m.group(0)), text)
    text = _SALARY_JUNK.sub(" ", text)
    found = _SALARY_NUMBER.findall(text)
    if not found:
        return None
    values = []
    for each in found:
        try:
            values.append(float(re.sub(r"[.,'\u2019\s]", "", each)))
        except ValueError:
            continue
    values = [v for v in values if SALARY_FLOOR <= v <= SALARY_CEILING]
    if not values:
        return None
    if len(values) == 1:
        return values[0]
    if len(values) == 2 and _SALARY_RANGE.search(str(raw)):
        # A range: "$ 12000 - $ 13000". The midpoint is what a reader takes
        # from it, and it is what a median over many of them should see.
        #
        # Only when something in the cell actually separates the two. "2,5"
        # also parses to two numbers, and averaged as a range it becomes 3.5.
        return (values[0] + values[1]) / 2.0
    # Three or more numbers is not a salary, it is a sentence with figures in
    # it. Guessing which one is the pay is how a column of noise becomes a
    # confident chart.
    return None


def add_numeric_salary(document):
    """The salary as a number, absent when the cell does not state one.

    Absent rather than zero, for the same reason latitude_d is absent rather
    than zero: indexed as zero, the fifteen million records that say "To be
    agreed" would drag every average to the floor, and salary_d:[* TO *]
    would stop meaning "states a salary".

    Not comparable across countries. A Colombian peso and a Peruvian sol are
    three orders of magnitude apart, so anything that averages this column
    over the whole corpus is measuring the mix of countries in it. Group by
    country, or index each country against its own baseline.
    """
    value = parse_salary(document.get("salary"))
    if value is not None:
        document["salary_d"] = value


def canonical_country(text):
    """One spelling per country.

    The corpus writes each of them several ways, and a facet believes every
    one of them. Over eight sampled days:

      Mexico     'Mexico' 99,064   'mexico' 11,814   unaccented 8,634
      Peru       'Peru'   61,781   'peru'   10,845   unaccented 1,006
      Colombia   'Colombia' 66,302 'colombia' 9,489
      Argentina  'Argentina' 27,730 'argentina' 3,707

    Left alone, the country facet spends three of its buckets on Mexico and
    the salary panel draws it as three countries with three different
    medians -- which is a confident chart of nothing. Accents stripped and
    title cased, so the accented and unaccented spellings land together and
    the case variants with them.
    """
    folded = unicodedata.normalize("NFKD", text)
    folded = "".join(ch for ch in folded if not unicodedata.combining(ch))
    return folded.title()


def add_country(document):
    """The country, which the corpus only records inside the location string.

    location reads "Chacarita - Buenos Aires, Ciudad Autonoma de Buenos
    Aires, Argentina": the country is the last comma separated part. There
    are 80,110 distinct locations and no country column, so without this
    every question about a country is a question about 161 departments whose
    names a reader is expected to already know -- and the salary figures
    cannot be grouped by the currency they are quoted in.

    About 54% of records carry one. The other 46% have only a city in that
    cell, which is the same records the geo-fixing never reached -- so
    country:[* TO *] is "was geo-fixed", and a panel grouping by country is
    answering over half the corpus rather than all of it.
    """
    raw = document.get("location")
    if raw is None:
        return
    parts = [p.strip() for p in str(raw).split(",")]
    parts = [p for p in parts if p]
    if len(parts) < 2:
        return
    country = parts[-1]
    # A country name, not a street. Long strings and digits mean the cell was
    # not shaped the way this assumes.
    if len(country) > 40 or any(ch.isdigit() for ch in country):
        return
    document["country"] = canonical_country(country)


def add_numeric_coordinates(document):
    """Coordinates Solr can do arithmetic on.

    latitude and longitude are string fields and have to stay that way: they
    are required, the corpus leaves them blank in about 1% of records, and a
    blank is not a number. So a range query over them compares text -- asking
    for latitude between -56 and 14 returns nothing at all, and asking for
    the northern hemisphere returns half of Argentina.

    These carry the same values as numbers, and are simply absent when there
    is no number to carry:

      blank    the cell was empty; 1,244,002 records
      0, 0     the geo-fixing service was never run on it, or failed; a
               third of the corpus. Indexed as zero it is a real place off
               west Africa, and every average over latitude is dragged
               toward the Gulf of Guinea by forty million records sitting
               there.

    Absent rather than zero means latitude_d:[* TO *] is exactly "has a
    position", which is the filter every geographic question starts with.
    """
    for name in ("latitude", "longitude"):
        raw = document.get(name)
        if raw is None or str(raw).strip() == "":
            continue
        try:
            value = float(raw)
        except (TypeError, ValueError):
            continue
        document[name + "_d"] = value
    if document.get("latitude_d") == 0.0 and document.get("longitude_d") == 0.0:
        document.pop("latitude_d", None)
        document.pop("longitude_d", None)


def post(url, batch, timeout):
    request = urllib.request.Request(
        url.rstrip("/") + "/update?wt=json",
        data=json.dumps(batch).encode("utf-8"),
        headers={"Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(request, timeout=timeout) as response:
        response.read()


def run_marker_beat():
    """Tell anything watching that this stage is still working.

    Indexing is the longest single stretch of a run after the corpus read,
    and it writes nothing a watcher can see until the very end: Solr holds
    the documents uncommitted, so the index reads as empty the whole way
    through. Gloss treats a marker whose heartbeat has gone quiet as a run
    that died and deletes it, so ten minutes into a join it reported IDLE
    while four shards were busy building the index.

    Extract beats for the same reason. The join was left out, four lines
    away in the same file.
    """
    marker = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                          "bt-run-marker")
    try:
        subprocess.run([sys.executable, marker, "beat"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       check=False, timeout=30)
    except Exception as e:
        log("  could not run the run marker: %s" % e)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="bt-join-index",
        description="Apply translations to every row and index the result.")
    parser.add_argument("--corpus", required=True)
    parser.add_argument("--translated", required=True,
                        help="directory of translated chunk files, counted "
                             "to decide whether the translate stage is done")
    parser.add_argument("--translations-db", required=True,
                        help="the database bt-build-translation-db wrote")
    parser.add_argument("--solr-url", required=True)
    parser.add_argument("--colheaders", required=True)
    parser.add_argument("--encodings", default=None,
                        help="conf/encoding.txt: encodings to try, in order")
    parser.add_argument("--translate-cols", required=True)
    parser.add_argument("--batch-size", type=int, default=5000)
    parser.add_argument("--timeout", type=int, default=600)
    # One instance takes one slice of the corpus. Files rather than rows,
    # so a slice is decided without reading anything.
    parser.add_argument("--shard", type=int, default=0)
    parser.add_argument("--of", type=int, default=1)
    parser.add_argument("--commit", action="store_true",
                        help="commit at the end of this shard")
    # One commit for the whole corpus, not one per shard: a commit is
    # expensive and eight of them in parallel is eight merges competing.
    parser.add_argument("--commit-only", action="store_true",
                        help="commit what is already posted and do nothing "
                             "else")
    # The join must not start on a partial set. A quiet period is a guess:
    # chunks are length sorted, so the last ones take the longest, and a
    # gap between two of them looks exactly like the end of the run. One
    # join ran on seven chunks of ten and indexed every record, reporting
    # success, with the longest strings left in Spanish.
    parser.add_argument("--expect", type=int, default=0,
                        help="backstop: refuse to index unless this many "
                             "translated chunks are on disk. The workflow "
                             "gate TranslationsSettled is the primary check")
    # Four hours made sense when this flag was how the join waited for
    # translation to finish. With TranslationsSettled gating the task, the
    # counts already agree before we start and anything left to wait for is
    # a file becoming visible, which is minutes. A backstop that can block
    # for half a working day is not a backstop.
    parser.add_argument("--expect-timeout", type=int, default=900,
                        help="give up waiting after this many seconds")
    args = parser.parse_args(argv)

    if args.of < 1 or not 0 <= args.shard < args.of:
        parser.error("--shard must be in [0, --of)")

    if args.commit_only:
        urllib.request.urlopen(
            args.solr_url.rstrip("/") + "/update?commit=true&wt=json",
            timeout=args.timeout * 6).read()
        log("committed")
        return 0

    paths = sorted(glob.glob(os.path.join(args.corpus, "*.tsv")))
    if not paths:
        parser.error("no .tsv files under %s" % args.corpus)
    mine = paths[args.shard::args.of]

    columns = read_columns(args.colheaders)
    encodings = bt_encoding.read_encodings(args.encodings)
    wanted = set(read_columns(args.translate_cols))
    translate_at = {i for i, name in enumerate(columns) if name in wanted}

    if args.expect:
        waited = wait_for_chunks(args.translated, args.expect,
                                 args.expect_timeout)
        if waited < args.expect:
            raise SystemExit(
                "only %d of %d translated chunks after %ds; refusing to "
                "index a partial translation. The documents would all be "
                "there and some of them would still be in the source "
                "language. TranslationsSettled should have held this task "
                "until the counts matched -- check the condition before "
                "raising --expect-timeout."
                % (waited, args.expect, args.expect_timeout))

    if not os.path.exists(args.translations_db):
        parser.error("no translation database at %s; build it with "
                     "bt-build-translation-db" % args.translations_db)
    table = Translations(args.translations_db)
    known = table.count()
    if known == 0:
        parser.error("the translation database at %s is empty -- did the "
                     "translate stage finish?" % args.translations_db)
    log("shard %d/%d: %d files, %d translations from %s"
        % (args.shard, args.of, len(mine), known, args.translations_db))

    # Read from the schema rather than restated here, so a schema change
    # cannot leave this silently posting documents Solr will reject.
    required = ["postedDate", "department", "title", "salary", "start",
                "duration", "jobtype", "applications", "company",
                "contactPerson", "latitude", "longitude", "firstSeenDate",
                "url", "lastSeenDate"]
    dates = ["postedDate", "firstSeenDate", "lastSeenDate"]

    batch = []
    posted = skipped = seen = 0
    started = time.time()
    beat = run_marker_beat
    for path in mine:
        base = os.path.basename(path)
        for number, parts in enumerate(
                records(path, columns, encodings)):
            seen += 1
            document, missing = build_document(
                parts, columns, translate_at, table, required, dates,
                "%s-%d" % (base, number))
            if missing:
                skipped += 1
                continue
            batch.append(document)
            if len(batch) >= args.batch_size:
                post(args.solr_url, batch, args.timeout)
                posted += len(batch)
                batch = []
                # A batch is the only regular event in an hour of indexing,
                # so it is where the run says it is still alive. Saying so
                # is never worth losing the batch for.
                try:
                    beat()
                except Exception as e:
                    log("  could not refresh the run marker: %s" % e)
    if batch:
        post(args.solr_url, batch, args.timeout)
        posted += len(batch)
    if args.commit:
        urllib.request.urlopen(
            args.solr_url.rstrip("/") + "/update?commit=true&wt=json",
            timeout=args.timeout * 3).read()

    elapsed = time.time() - started
    lookups = table.hits + table.misses
    log("shard %d/%d: %d records, %d posted, %d skipped for missing "
        "required fields, %.0fs (%.0f docs/s)"
        % (args.shard, args.of, seen, posted, skipped, elapsed,
           posted / elapsed if elapsed else 0))
    log("shard %d/%d: %d lookups, %.1f%% from cache, %d cached"
        % (args.shard, args.of, lookups,
           100.0 * table.hits / lookups if lookups else 0, len(table.cache)))
    table.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
