# Run BigTranslate across more than one machine.
#
# Every node is described in conf/nodes.conf and nothing here knows a
# hostname. The first multi-node run was assembled by hand -- a node block
# appended to one machine's setenv.sh, jars copied into fourteen lib
# directories, chunks rsynced, an NFS mount that hung twice -- and none of it
# was written down anywhere a second run could repeat. This is that, made
# repeatable.
#
# Two rules the hand-built version kept breaking, worth stating because they
# are not obvious:
#
#   The same absolute path on every machine. The File Manager catalogues
#   absolute paths and the Workflow Manager writes them into task metadata,
#   so a node has to find bin, conf and chunks exactly where the manager
#   says they are. BIGTRANSLATE_HOME is therefore identical everywhere,
#   which is why a node's tree is not under its own home directory.
#
#   Addresses that resolve from the node, never from here. localhost and a
#   bare short hostname are both correct on the machine that writes them and
#   meaningless on the machine that reads them.

set -e

die() { echo "bt-cluster: $*" >&2; exit 1; }

if [ -z "$BIGTRANSLATE_HOME" ]; then
  _bt_bin=$(cd "$(dirname "$0")" && pwd)
  BIGTRANSLATE_HOME=$(cd "$_bt_bin/.." && pwd)
fi

# Options before the command, so nothing depends on what happens to be
# exported in the calling shell. Sourcing setenv.sh first still works and is
# the ordinary way; these are for driving it from somewhere that has not.
# The jars whose version actually decides behaviour across machines. Checked
# rather than every jar, because a full comparison is slow and noisy and these
# are the ones that have gone stale and cost a run.
#
# tomcat/webapps is excluded throughout. A war carries its own copy of what it
# needs and is built and deployed on its own schedule, so holding it to the
# component libraries reports a difference that is not a fault -- and a check
# that reports faults nobody will act on is a check nobody reads.
PREFLIGHT_JARS="cas-workflow-*.jar cas-resource-*.jar cas-filemgr-*.jar bigtranslate-extensions-*.jar"

COMMAND=""
ONLY_NODE=""
CHUNK_SRC=""
while [ $# -gt 0 ]; do
  case "$1" in
    --home)       BIGTRANSLATE_HOME="$2"; shift 2 ;;
    --home=*)     BIGTRANSLATE_HOME="${1#*=}"; shift ;;
    --pantogloss) PANTOGLOSS_SOURCE="$2"; shift 2 ;;
    --pantogloss=*) PANTOGLOSS_SOURCE="${1#*=}"; shift ;;
    --nodes)      NODES_CONF="$2"; shift 2 ;;
    --nodes=*)    NODES_CONF="${1#*=}"; shift ;;
    --ssh)        SSH="$2"; shift 2 ;;
    --ssh=*)      SSH="${1#*=}"; shift ;;
    --chunks)     CHUNK_SRC="$2"; shift 2 ;;
    --chunks=*)   CHUNK_SRC="${1#*=}"; shift ;;
    --node)       ONLY_NODE="$2"; shift 2 ;;
    --node=*)     ONLY_NODE="${1#*=}"; shift ;;
    -h|--help)    COMMAND="help"; shift ;;
    -*)           die "unknown option: $1" ;;
    *)            if [ -z "$COMMAND" ]; then COMMAND="$1"; else ONLY_NODE="$1"; fi; shift ;;
  esac
done

export BIGTRANSLATE_HOME
export PANTOGLOSS_SOURCE

NODES_CONF="${NODES_CONF:-${BT_NODES_CONF:-$BIGTRANSLATE_HOME/conf/nodes.conf}}"
SSH="${SSH:-${BT_SSH:-ssh -o BatchMode=yes}}"

[ -f "$NODES_CONF" ] || die "no node list at $NODES_CONF"

# --node picks one out of the list. Adding a machine to a running cluster
# should not mean redeploying the ones already working.
select_node() {
  if [ -z "$ONLY_NODE" ]; then
    cat
  else
    awk -v want="$ONLY_NODE" '$1 == want'
  fi
}

# id host capacity, one per line, comments and blanks dropped.
node_lines() {
  grep -vE '^[[:space:]]*(#|$)' "$NODES_CONF"
}

manager_host() { node_lines | head -1 | awk '{print $2}'; }
manager_id()   { node_lines | head -1 | awk '{print $1}'; }

# Every node after the first. Those are the ones needing ssh, a deployment
# and staged inputs; the first is this machine.
remote_lines() { node_lines | tail -n +2 | select_node; }

for_each_remote() {
  found=$(remote_lines | wc -l | tr -d ' ')
  if [ -n "$ONLY_NODE" ] && [ "$found" -eq 0 ] && ! manager_selected; then
    die "no node called [$ONLY_NODE] in $NODES_CONF (the first line is this machine and is not deployed to)"
  fi
  remote_lines | while read -r id host capacity; do
    [ -n "$id" ] || continue
    "$@" "$id" "$host" "${capacity:-8}"
  done
}

# ---------------------------------------------------------------- policy ---

# nodes.xml and the queue mapping, written from the node list.
#
# These were two hand-maintained files naming exactly two nodes, "local" and
# "gpu", through BIGTRANSLATE_NODE_URL and BIGTRANSLATE_NODE2_URL. A third
# node meant editing both by hand and inventing a third variable.
cmd_policy() {
  nodes_xml="$BIGTRANSLATE_HOME/resmgr/policy/nodes.xml"
  map_xml="$BIGTRANSLATE_HOME/resmgr/policy/node-to-queue-mapping.xml"
  port="${BIGTRANSLATE_NODE_PORT:-2001}"

  {
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo '<!-- Generated by bin/bt-cluster policy from conf/nodes.conf.'
    echo '     Edit that file, not this one. -->'
    echo '<cas:nodes xmlns:cas="http://oodt.jpl.nasa.gov/1.0/resource">'
    first=yes
    node_lines | while read -r id host capacity conditions managers; do
      [ -n "$id" ] || continue
      echo "  <node nodeId=\"$id\" ip=\"http://$host:$port\" capacity=\"${capacity:-8}\"/>"
      if [ "$first" = yes ]; then
        # And again for the managers queue, for the same reason. Extract and
        # join sharing a pool with translate is how the join came to sit
        # queued behind 131 translate jobs on a full node, on a run where
        # every translation had succeeded.
        echo "  <node nodeId=\"$id-managers\" ip=\"http://$host:$port\" capacity=\"${managers:-4}\"/>"
        # The same machine again, under a second id. The Resource Manager
        # tracks load per node id, not per queue: a node's capacity is one
        # pool shared by every queue it serves, so conditions and translations
        # on one id compete for the same slots. Conditions are cheap and
        # constant and translations are slow and few, and on a shared pool the
        # translations win and the gates they are waiting on cannot get a slot
        # to open. Two ids on one host give them separate pools.
        echo "  <node nodeId=\"$id-conditions\" ip=\"http://$host:$port\" capacity=\"${conditions:-20}\"/>"
      fi
      first=no
    done
    echo '</cas:nodes>'
  } > "$nodes_xml"

  {
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo '<!-- Generated by bin/bt-cluster policy from conf/nodes.conf.'
    echo '     Every node serves translate: a chunk carries no state beyond'
    echo '     its own output file, so any node may take any chunk. Only the'
    echo '     first machine serves managers, because extract reads the corpus'
    echo '     and join writes the Solr index, and those disks are attached to'
    echo '     the machine running the managers.'
    echo ''
    echo '     managers gets a node id of its own on that machine, not just a'
    echo '     queue. The Resource Manager tracks load per node id, so a queue'
    echo '     sharing an id with translate shares its capacity: on a 458 chunk'
    echo '     run the join sat queued behind 131 translate jobs with all eight'
    echo '     slots taken, after every translation had already succeeded. Its'
    echo '     capacity is small because the work is: one extract, one join.'
    echo ''
    echo '     Conditions get a queue of their own AND a node id of their own,'
    echo '     on that same machine. The Resource Manager tracks load per node'
    echo '     id, so a node capacity is one pool shared by every queue that'
    echo '     node serves; a queue alone partitions nothing. A second id on'
    echo '     the same host is what gives conditions a pool that long running'
    echo '     translations cannot exhaust. A'
    echo '     condition reads the manager filesystem, so it can only run'
    echo '     there; and it is re-asked until it passes, so a few hundred'
    echo '     gated tasks generate steady scheduling traffic. Sharing the'
    echo '     managers queue would let that traffic occupy the slots extract'
    echo '     and join need, and the join is itself gated by a condition,'
    echo '     so conditions would end up delaying the work they gate. -->'
    echo '<cas:nodeMap xmlns:cas="http://oodt.jpl.nasa.gov/1.0/resource">'
    first=yes
    node_lines | while read -r id host capacity; do
      [ -n "$id" ] || continue
      echo "  <node id=\"$id\">"
      echo '    <queues>'
      echo '      <queue name="translate"/>'
      echo '    </queues>'
      echo '  </node>'
      if [ "$first" = yes ]; then
        echo "  <node id=\"$id-managers\">"
        echo '    <queues>'
        echo '      <queue name="managers"/>'
        echo '    </queues>'
        echo '  </node>'
        echo "  <node id=\"$id-conditions\">"
        echo '    <queues>'
        echo '      <queue name="conditions"/>'
        echo '    </queues>'
        echo '  </node>'
      fi
      first=no
    done
    echo '</cas:nodeMap>'
  } > "$map_xml"

  # Parsed before anyone depends on them. A generated file that does not
  # parse takes the Resource Manager down at startup, which takes the Workflow
  # Manager with it ("Null engine"), and the message that actually names the
  # problem is several stack traces deep in a log nobody is tailing. The
  # specific way this has gone wrong here, repeatedly, is a "--" inside an XML
  # comment, which is not permitted and which nothing warns about at the point
  # it is written.
  for generated in "$nodes_xml" "$map_xml"; do
    python3 -c "import sys,xml.dom.minidom as m; m.parse(sys.argv[1])" "$generated" \
      || die "generated $generated is not valid XML; it has not been left in a usable state"
  done

  echo "wrote $nodes_xml and $map_xml for $(node_lines | wc -l | tr -d ' ') node(s)"
}

# ---------------------------------------------------------------- deploy ---

deploy_one() {
  id=$1; host=$2
  echo "deploying to $id ($host) at $BIGTRANSLATE_HOME"
  $SSH "$host" "mkdir -p '$BIGTRANSLATE_HOME'" \
    || die "cannot create $BIGTRANSLATE_HOME on $host (needs to be writable by you)"
  # Everything except what is per-machine or regenerated. The venv is built
  # on the node: a virtualenv records absolute paths and its binaries are
  # built for one architecture, so copying one from an arm64 Mac to a Linux
  # box produces a tree that looks right and cannot run.
  rsync -a --delete \
    --exclude '.venv' --exclude 'logs/*' --exclude 'run/*' \
    --exclude 'data/jobs/*' --exclude 'data/translated/*' \
    --exclude 'bin/setenv.sh' \
    -e "$SSH" "$BIGTRANSLATE_HOME/" "$host:$BIGTRANSLATE_HOME/"
  $SSH "$host" "cd '$BIGTRANSLATE_HOME' && PANTOGLOSS_SOURCE='${PANTOGLOSS_SOURCE:-pantogloss}' bin/bigtranslate-setup" \
    || die "could not build the python environment on $host"
  echo "  $id ready"
}

cmd_deploy() { for_each_remote deploy_one; echo "deploy complete"; }

# ------------------------------------------------------------------ stage ---

stage_one() {
  id=$1; host=$2
  echo "staging inputs to $id ($host)"
  # Read-only inputs only. A node writes its own outputs and they come back
  # through the File Manager, so nothing is copied in that direction.
  for d in conf bin pge/policy workflow/policy data/strings; do
    [ -d "$BIGTRANSLATE_HOME/$d" ] || continue
    $SSH "$host" "mkdir -p '$BIGTRANSLATE_HOME/$d'"
    rsync -a --exclude 'setenv.sh' -e "$SSH" \
      "$BIGTRANSLATE_HOME/$d/" "$host:$BIGTRANSLATE_HOME/$d/"
  done
  # A manifest of what actually arrived, written here on the manager, because
  # ChunkStagedCondition runs in the Workflow Manager and cannot stat a remote
  # disk. Ask the node what it has rather than assuming the rsync copied what
  # we sent -- a manifest that lists a file the node does not have would
  # release a job that then fails, which is the whole failure this prevents.
  mkdir -p "$BIGTRANSLATE_HOME/data/staging"
  manifest="$BIGTRANSLATE_HOME/data/staging/$id.staged"
  record_staged "$id" "$host"
}

record_staged() {
  id=$1; host=$2
  mkdir -p "$BIGTRANSLATE_HOME/data/staging"
  manifest="$BIGTRANSLATE_HOME/data/staging/$id.staged"
  # Assigned before it is written, so that a failed ssh is a failure. Piping
  # straight into the file would report the exit status of the local sort,
  # and an unreachable node would quietly produce an empty manifest.
  listing=$($SSH "$host" "find '$BIGTRANSLATE_HOME/data/strings' -name 'chunk-*.json' -type f | sed 's|.*/||' | sort") \
    || die "could not list the staged chunks on $host"
  printf '%s\n' "$listing" > "$manifest.tmp"
  # Renamed into place so the condition never reads a half-written list.
  mv "$manifest.tmp" "$manifest"
  staged=$(grep -c . "$manifest" | tr -d ' ')
  echo "  $id has $staged chunk file(s)"
}

# ----------------------------------------------------------- stage-chunks ---

# Just the chunk files, from wherever they have this moment been written.
#
# Called by the extract task, before its output is ingested. That is the only
# point at which every node can be given the chunks before anything can be
# asked to translate one: ingest is what fires the chunk event, the event is
# what creates the translate task, and a task's precondition is evaluated when
# the task appears. Staging afterwards is a race; staging here removes it.
stage_chunks_one() {
  id=$1; host=$2
  echo "staging chunks to $id ($host)"
  incoming="$BIGTRANSLATE_HOME/data/strings/.incoming"
  $SSH "$host" "rm -rf '$incoming' && mkdir -p '$incoming'" \
    || die "could not create data/strings on $host"
  rsync -a --include 'chunk-*.json' --include 'chunk-*.json/***' --exclude '*' \
    -e "$SSH" "$CHUNK_SRC/" "$host:$incoming/" \
    || die "could not copy chunks to $host"

  # Put each chunk where the task will look for it, which is not where it was
  # copied from. A translate task resolves its input from the catalogue --
  # FileLocation joined to Filename -- and that names the File Manager's
  # archive, which BasicVersioner lays out as <name>/<name>. Chunks handed to
  # us straight from the extract job are flat, so staging them as they came
  # puts every one of them a directory level away from the only path the task
  # will ever try. That failed every job on the staged node instantly, and
  # looked like a node that would not saturate.
  #
  # Both shapes are accepted, because the source is the extract output on a
  # first run and the manager's own archive on a re-stage.
  $SSH "$host" "cd '$incoming' || exit 1
    for f in chunk-*.json; do
      [ -e \"\$f\" ] || continue
      mkdir -p \"../\$f\" || exit 1
      if [ -d \"\$f\" ]; then
        mv -f \"\$f\"/* \"../\$f\"/ || exit 1
        rmdir \"\$f\" || exit 1
      else
        mv -f \"\$f\" \"../\$f/\$f\" || exit 1
      fi
    done
    cd .. && rmdir .incoming 2>/dev/null || true" \
    || die "could not place the chunks into the archive layout on $host"

  record_staged "$id" "$host"
}

cmd_stage_chunks() {
  [ -n "$CHUNK_SRC" ] || CHUNK_SRC="$BIGTRANSLATE_HOME/data/strings"
  [ -d "$CHUNK_SRC" ] || die "no such directory: $CHUNK_SRC"
  if [ "$(remote_lines | wc -l | tr -d ' ')" -eq 0 ]; then
    # One machine, which wrote the chunks itself. Nothing to copy and nothing
    # to wait for, and saying so is not a failure.
    echo "no compute nodes beyond the manager; nothing to stage"
    return 0
  fi
  for_each_remote stage_chunks_one
  echo "chunk staging complete"
}

cmd_stage() { for_each_remote stage_one; echo "staging complete"; }

# ------------------------------------------------------- start/stop/status ---

start_one() { echo "starting $1 ($2)"; $SSH "$2" "cd '$BIGTRANSLATE_HOME' && . ./bin/setenv.sh && ./bin/bt-node start" || true; }
stop_one()  { echo "stopping $1 ($2)"; $SSH "$2" "cd '$BIGTRANSLATE_HOME' && . ./bin/setenv.sh && ./bin/bt-node stop" || true; }
status_one(){ printf '%-10s %-22s ' "$1" "$2"; $SSH "$2" "cd '$BIGTRANSLATE_HOME' && . ./bin/setenv.sh && ./bin/bt-node status" 2>&1 | tail -1; }

# --node applies to this machine too. Asking about one node and being told
# about all of them is the sort of small dishonesty that makes a script
# untrustworthy for scripting against.
manager_selected() {
  [ -z "$ONLY_NODE" ] || [ "$ONLY_NODE" = "$(manager_id)" ]
}

cmd_start() {
  manager_selected && "$BIGTRANSLATE_HOME"/bin/bt-node start
  for_each_remote start_one
}

cmd_stop() {
  for_each_remote stop_one
  manager_selected && "$BIGTRANSLATE_HOME"/bin/bt-node stop
}

# --------------------------------------------------------------- preflight ---

# Is what is deployed what we think is deployed?
#
# Twice in one day a run was lost to a fix that existed in git and not on
# disk: a jar rebuilt and copied into one lib directory out of nine, and a
# script committed but never deployed. Both looked identical from the outside
# and neither was visible until hours of compute had been spent. This is the
# five second check that would have caught them.
#
# It reports and does not repair, because what is right depends on what you
# were doing: a stale jar on a node wants a deploy, and a jar newer than the
# manager's usually means a hot swap that wants finishing.
preflight_one() {
  id=$1; host=$2
  fail=0
  reachable=$($SSH "$host" "echo ok" 2>/dev/null)
  if [ "$reachable" != "ok" ]; then
    echo "  $id ($host): UNREACHABLE"
    return 1
  fi
  if ! $SSH "$host" "[ -d '$BIGTRANSLATE_HOME' ]" 2>/dev/null; then
    echo "  $id ($host): no $BIGTRANSLATE_HOME (every machine uses the same path)"
    return 1
  fi
  for jar in $PREFLIGHT_JARS; do
    # Both sides through the same normaliser. Comparing a trailing space
    # against no trailing space reports every jar as differing, which is
    # noise that teaches you to ignore the check.
    mine=$(preflight_sum "$BIGTRANSLATE_HOME" "$jar")
    theirs=$($SSH "$host" "cd '$BIGTRANSLATE_HOME' 2>/dev/null && find . -name '$jar' -not -path '*/target/*' -not -path '*/tomcat/webapps/*' -exec shasum {} + 2>/dev/null | awk '{print \$1}' | sort -u")
    theirs=$(preflight_normalise "$theirs")
    if [ -z "$theirs" ]; then
      echo "  $id: $jar MISSING"; fail=1
    elif [ "$theirs" != "$mine" ]; then
      echo "  $id: $jar DIFFERS from the manager"
      echo "      manager: $mine"
      echo "      $id: $theirs"
      fail=1
    fi
  done
  if [ "$fail" = 0 ]; then
    echo "  $id ($host): ok"
  else
    # for_each_remote runs this in a subshell, so a return value cannot reach
    # the caller. A marker file can.
    [ -n "$PREFLIGHT_FAILED" ] && : > "$PREFLIGHT_FAILED"
  fi
  return $fail
}

# One sorted, space separated list of sums with no leading or trailing space,
# whichever side it came from.
preflight_normalise() {
  echo $(echo "$1" | sort -u | tr '\n' ' ')
}

# Every copy of a jar in this tree, as one sorted list of sums. More than one
# sum means the tree disagrees with itself, which is the hot swap case.
preflight_sum() {
  home=$1; jar=$2
  preflight_normalise "$(cd "$home" 2>/dev/null && find . -name "$jar" \
    -not -path '*/target/*' -not -path '*/tomcat/webapps/*' \
    -exec shasum {} + 2>/dev/null | awk '{print $1}')"
}

# Do every OODT jar under this tree come from one build? Prints the offending
# spread and returns non-zero when they do not.
bt_jars_from_one_build() {
  bt_home=$1
  bt_oldest=""; bt_newest=""; bt_seen=""
  for jar in $(bt_oodt_jars "$bt_home"); do
    stamp=$(bt_file_epoch "$jar")
    [ -n "$stamp" ] || continue
    base=$(basename "$jar")
    case " $bt_seen " in *" $base "*) continue ;; esac
    bt_seen="$bt_seen $base"
    if [ -z "$bt_oldest" ]; then bt_oldest=$stamp; bt_newest=$stamp; fi
    [ "$stamp" -lt "$bt_oldest" ] && bt_oldest=$stamp
    [ "$stamp" -gt "$bt_newest" ] && bt_newest=$stamp
  done
  [ -n "$bt_oldest" ] || return 0
  span=$(( (bt_newest - bt_oldest) / 86400 ))
  [ "$span" -lt 1 ] && return 0
  echo "  manager: OODT jars span ${span} day(s) of builds; this tree was"
  echo "           assembled from more than one build, so a policy naming"
  echo "           a newly added class may be deployed against a jar that"
  echo "           predates it. Rebuild and redeploy together."
  for jar in $(bt_oodt_jars "$bt_home"); do
    [ -n "$(bt_file_epoch "$jar")" ] || continue
    echo "             $(bt_file_day "$jar")  $(basename "$jar")"
  done | sort -u
  return 1
}

# The OODT jars, without the sources and javadoc ones. A javadoc jar holds no
# classes at all, so treating it as the artifact reads as "class missing".
bt_oodt_jars() {
  find "$1" \( -name 'cas-*.jar' -o -name 'oodt-*.jar' \) 2>/dev/null \
    | grep -vE 'sources|javadoc' | sort -u
}

# Modification time as epoch seconds. BSD and GNU stat disagree on flags,
# and this runs on the macOS manager and the Linux nodes both.
bt_file_epoch() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null
}

bt_file_day() {
  stat -f "%Sm" -t "%Y-%m-%d" "$1" 2>/dev/null \
    || stat -c "%y" "$1" 2>/dev/null | cut -d" " -f1
}

# Is anything accepting connections on this port, on any address?
bt_port_listening() {
  python3 - "$1" <<'EOF' 2>/dev/null
import socket, sys
port = int(sys.argv[1])
for host in ("127.0.0.1", "0.0.0.0"):
    s = socket.socket()
    s.settimeout(1.5)
    try:
        s.connect(("127.0.0.1", port))
        sys.exit(0)
    except OSError:
        pass
    finally:
        s.close()
sys.exit(1)
EOF
}

# Does this url's own host and port accept a connection? The question is
# whether the address a task will be handed reaches the service, so it is
# the address that is dialled, not the port on loopback.
bt_url_reachable() {
  python3 - "$1" <<'EOF' 2>/dev/null
import socket, sys
try:
    from urllib.parse import urlparse
except ImportError:
    sys.exit(0)
parsed = urlparse(sys.argv[1])
if not parsed.hostname:
    sys.exit(0)
port = parsed.port or (443 if parsed.scheme == "https" else 80)
s = socket.socket()
s.settimeout(3.0)
try:
    s.connect((parsed.hostname, port))
except OSError:
    sys.exit(1)
finally:
    s.close()
sys.exit(0)
EOF
}

cmd_preflight() {
  rc=0
  PREFLIGHT_FAILED="$BIGTRANSLATE_HOME/.preflight-failed.$$"
  rm -f "$PREFLIGHT_FAILED"
  echo "checking $BIGTRANSLATE_HOME"

  # 1. The manager's own tree must agree with itself. A jar copied into one
  #    lib directory and not the other eight is the exact shape of the bug
  #    that let a stale batch manager run against a fixed workflow manager.
  for jar in $PREFLIGHT_JARS; do
    sums=$(preflight_sum "$BIGTRANSLATE_HOME" "$jar")
    count=$(echo $sums | wc -w | tr -d ' ')
    if [ "$count" -eq 0 ]; then
      echo "  manager: $jar MISSING"; rc=1
    elif [ "$count" -gt 1 ]; then
      echo "  manager: $jar has $count different versions in this tree"; rc=1
    fi
  done

  # 2. Generated policy has to parse. An unparseable queue map takes the
  #    Resource Manager down at startup and the Workflow Manager with it.
  for generated in "$BIGTRANSLATE_HOME/resmgr/policy/nodes.xml" \
                   "$BIGTRANSLATE_HOME/resmgr/policy/node-to-queue-mapping.xml" \
                   "$BIGTRANSLATE_HOME/workflow/policy/conditions.xml" \
                   "$BIGTRANSLATE_HOME/workflow/policy/tasks.xml"; do
    if [ ! -f "$generated" ]; then
      echo "  manager: $(basename "$generated") MISSING"; rc=1
    elif ! python3 -c "import sys,xml.dom.minidom as m; m.parse(sys.argv[1])" "$generated" 2>/dev/null; then
      echo "  manager: $(basename "$generated") DOES NOT PARSE"; rc=1
    fi
  done

  # 3. Every queue a task asks for has to be served by some node, or its jobs
  #    are unschedulable and the tasks fail as though their work had failed.
  if [ -f "$BIGTRANSLATE_HOME/workflow/policy/tasks.xml" ] \
     && [ -f "$BIGTRANSLATE_HOME/resmgr/policy/node-to-queue-mapping.xml" ]; then
    wanted=$(grep -oE 'name="QueueName" value="[^"]*"' \
      "$BIGTRANSLATE_HOME/workflow/policy/tasks.xml" \
      "$BIGTRANSLATE_HOME/workflow/policy/conditions.xml" 2>/dev/null \
      | sed 's/.*value="//;s/"//' | sort -u)
    served=$(grep -oE '<queue name="[^"]*"' \
      "$BIGTRANSLATE_HOME/resmgr/policy/node-to-queue-mapping.xml" \
      | sed 's/.*name="//;s/"//' | sort -u)
    for q in $wanted; do
      if ! echo "$served" | grep -qx "$q"; then
        echo "  manager: queue [$q] is asked for but no node serves it"; rc=1
      fi
    done
  fi

  # 4. A service that is running has to be reachable at the address the
  #    tasks are given. These are different things: the Workflow Manager
  #    substitutes the environment's URL into task metadata, and a task
  #    then connects to it. If the service is bound somewhere that address
  #    does not reach, everything looks healthy until the task runs.
  #
  #    That is not hypothetical. Solr binds loopback unless told otherwise,
  #    while SOLR_URL had been pointed at the LAN address so the compute
  #    nodes could be given reachable URLs for the OODT managers -- which do
  #    bind *:port. Solr was up, its core healthy, every page green, and the
  #    join would have failed on connection refused three hours into the run
  #    with every translation already done.
  #
  #    Only checked when something is listening: preflight is also run with
  #    the stack down, and "not running" is not a configuration error.
  for pair in "FILEMGR_URL:$FILEMGR_PORT" "WORKFLOW_URL:$WORKFLOW_PORT" \
              "RESMGR_URL:$RESMGR_PORT" "SOLR_URL:$SOLR_PORT"; do
    name=${pair%:*}
    port=${pair##*:}
    eval "url=\${$name:-}"
    [ -n "$url" ] || continue
    if ! bt_port_listening "$port"; then
      continue
    fi
    if ! bt_url_reachable "$url"; then
      echo "  manager: $name is $url, but nothing answers there while a"
      echo "           service is listening on port $port -- a task given"
      echo "           this address will fail to connect"
      rc=1
    fi
  done

  # 5. Every OODT jar should come from the same build.
  #
  #    Check 1 asks whether each named jar is identical across the nine lib
  #    directories, which it is even when the tree is assembled by partial
  #    rebuilds. It says nothing about cas-pge being six days older than
  #    cas-resource, and that is the drift that hurts: a policy file naming
  #    a class added last week, deployed against a jar built the week
  #    before, leaves the condition unable to instantiate and the stage it
  #    gates never released. Measured on this deployment mid-run:
  #
  #      Sep 10  cas-resource, cas-workflow, oodt-commons
  #      Sep  4  cas-pge, cas-filemgr, cas-metadata, cas-crawler, cas-cli
  #
  #    Modification time is a weak signal and the only one a jar carries:
  #    Maven stamps no build id into the manifest. rsync -t preserves it to
  #    the nodes, so it stays comparable there. A day's tolerance, because
  #    one build takes minutes and the drift worth catching is measured in
  #    days.
  if ! bt_jars_from_one_build "$BIGTRANSLATE_HOME"; then
    rc=1
  fi

  # 6. And the nodes must match the manager.
  #
  # Tolerated explicitly: this script runs under set -e, and preflight_one
  # returning non-zero for a node that is behind would abort before the
  # summary, so a failing check would print its findings and then no verdict.
  for_each_remote preflight_one || true
  if [ -f "$PREFLIGHT_FAILED" ]; then
    rc=1
    rm -f "$PREFLIGHT_FAILED"
  fi

  if [ "$rc" = 0 ]; then
    echo "preflight ok"
  else
    echo "preflight FAILED"
  fi
  return $rc
}

cmd_status() {
  if manager_selected; then
    printf '%-10s %-22s ' "$(manager_id)" "$(manager_host)"
    "$BIGTRANSLATE_HOME"/bin/bt-node status 2>&1 | tail -1
  fi
  for_each_remote status_one
}

case "${COMMAND:-}" in
  policy) cmd_policy ;;
  deploy) cmd_deploy ;;
  stage)  cmd_stage ;;
  stage-chunks) cmd_stage_chunks ;;
  start)  cmd_start ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  preflight) cmd_preflight ;;
  nodes)  node_lines ;;
  help|*)
    echo "usage: bt-cluster [options] {policy|deploy|stage|stage-chunks|preflight|start|stop|status|nodes} [node]"
    echo
    echo "options:"
    echo "  --home PATH        deployment root; the same absolute path on"
    echo "                     every machine. Defaults to this script's parent."
    echo "  --pantogloss SPEC  checkout, wheel or pip specifier for the"
    echo "                     translator, passed to bigtranslate-setup"
    echo "  --nodes FILE       node list (default conf/nodes.conf)"
    echo "  --ssh CMD          ssh command (default: ssh -o BatchMode=yes)"
    echo "  --node ID          act on one node instead of all of them; also"
    echo "                     accepted as a trailing argument"
    echo
    echo
    echo "  policy   write nodes.xml and the queue mapping from conf/nodes.conf"
    echo "  deploy   install BigTranslate and its python environment on each"
    echo "           remote node, at the same absolute path as here"
    echo "  stage-chunks  copy just the chunk files from --chunks <dir> to"
    echo "           each node's data/strings, then record what each node has."
    echo "           Run by the extract task before its output is ingested, so"
    echo "           that no translate task exists before every node can serve"
    echo "           it. Defaults to data/strings for a re-stage by hand."
    echo "  stage    copy conf, scripts, policy and the string chunks to each"
    echo "  start    batch stub and translation service, here and on each node"
    echo "  stop     the same, in reverse"
    echo "  status   what is actually listening, per node"
    echo "  nodes    the parsed node list"
    echo
    echo "Adding a machine is a line in the node list followed by:"
    echo "  bt-cluster policy"
    echo "  bt-cluster deploy --node <id> --pantogloss ~/git/pantogloss"
    echo "  bt-cluster stage  --node <id>"
    echo "  bt-cluster start  --node <id>"
    echo "and restarting the managers so the Resource Manager reads the new"
    echo "policy. Nothing here knows a hostname; everything comes from the"
    echo "node list."
    exit 1
    ;;
esac
