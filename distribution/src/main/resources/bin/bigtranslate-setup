# Creates the virtual environment holding the Python half of the pipeline.
# Run once after unpacking a distribution. Maven does not do this: it ships
# requirements.txt and this script, and the Python install happens here.
#
# env.sh puts this environment's program directory on PATH when it exists,
# so the servers -- and therefore the PGEs they run -- pick the tools up.

set -e

PRGDIR=$(cd "$(dirname "$0")" && pwd)
BIGTRANSLATE_HOME=${BIGTRANSLATE_HOME:-$(cd "$PRGDIR/.." && pwd)}
VENV="$BIGTRANSLATE_HOME/.venv"
REQUIREMENTS="$BIGTRANSLATE_HOME/requirements.txt"

# Pantogloss needs TensorFlow 2.18, which publishes no wheels above Python
# 3.12, so a bare "python3" on a newer system produces an environment the
# translate step cannot run in. Prefer a version known to work, newest first,
# and let PYTHON override.
if [ -z "$PYTHON" ]; then
    for candidate in python3.12 python3.11 python3.10 python3; do
        if command -v "$candidate" > /dev/null 2>&1; then
            PYTHON=$candidate
            break
        fi
    done
fi

if [ -z "$PYTHON" ] || ! command -v "$PYTHON" > /dev/null 2>&1; then
    echo "Cannot find a Python interpreter. Set PYTHON to one between 3.10 and 3.12." >&2
    exit 1
fi

PYTHON_VERSION=$("$PYTHON" -c 'import sys; print("%d.%d" % sys.version_info[:2])')
case "$PYTHON_VERSION" in
    3.10|3.11|3.12) ;;
    *)
        echo "$PYTHON is Python $PYTHON_VERSION."
        echo "ETLLib is fine with that, but Pantogloss needs TensorFlow 2.18, which"
        echo "publishes no wheels above 3.12. If you intend to translate, re-run with"
        echo "PYTHON set to a 3.10-3.12 interpreter."
        echo
        ;;
esac

echo "Using $PYTHON (Python $PYTHON_VERSION)"

if [ ! -f "$REQUIREMENTS" ]; then
    echo "Cannot find $REQUIREMENTS." >&2
    echo "This script expects to run from inside an unpacked distribution." >&2
    exit 1
fi

if [ -d "$VENV" ]; then
    echo "Using the existing environment at $VENV"
else
    echo "Creating $VENV"
    "$PYTHON" -m venv "$VENV"
fi

echo "Installing from $REQUIREMENTS"
# Where this virtualenv keeps its programs, now that there is one.
#
# "bin" on Unix, "Scripts" on Windows: python -m venv follows the platform of the
# interpreter, and a Windows interpreter writes Scripts even when invoked from
# Git Bash. This script assumed bin, so on the first deploy to a Windows node it
# created the environment, said so, and then stopped on
#
#   line 78: .../.venv/bin/pip: No such file or directory
#
# with a perfectly good environment sitting under .venv/Scripts.
VENV_BIN=""
for candidate in bin Scripts; do
    if [ -d "$VENV/$candidate" ]; then
        VENV_BIN="$VENV/$candidate"
        break
    fi
done
if [ -z "$VENV_BIN" ]; then
    echo "Created $VENV but it has neither bin nor Scripts in it."
    echo "Nothing can be installed into it. Remove it and run this again."
    exit 1
fi

# A python3 beside python, because the PGEs ask for python3 by name.
#
# Nine scripts in bin/ start with "#!/usr/bin/env python3", and env.sh puts this
# directory first on PATH so that they get the environment's interpreter and its
# packages. A Windows virtualenv installs python.exe and pythonw.exe and no
# python3.exe, so python3 would resolve past this directory to whatever else is
# on PATH -- an interpreter without pantogloss in it, which fails at import
# rather than at startup and reads like a broken install.
if [ ! -e "$VENV_BIN/python3" ] && [ ! -e "$VENV_BIN/python3.exe" ]; then
    if [ -e "$VENV_BIN/python.exe" ]; then
        cp "$VENV_BIN/python.exe" "$VENV_BIN/python3.exe"
        echo "  added python3.exe (a Windows venv ships python.exe alone)"
    fi
fi

# python -m pip, not the pip program.
#
# On Windows pip.exe cannot replace itself: the file is locked while it runs, and
# pip detects that and refuses rather than corrupting the install --
#
#   ERROR: To modify pip, please run the following command:
#          ...\.venv\Scripts\python.exe -m pip install --upgrade pip
#
# which stopped the deploy. Going through the interpreter is the documented form
# on every platform and has no such problem, so all of the installs below use it
# rather than only this one.
"$VENV_BIN/python" -m pip install --upgrade pip
"$VENV_BIN/python" -m pip install -r "$REQUIREMENTS"

# Pantogloss does the translating, but it is not in requirements.txt: it is not
# published, so a public dependency list cannot name it. It has to go in this
# same environment rather than one of its own, because the PGE runs
# bin/pantogloss-translatejson through "#!/usr/bin/env python3" and that
# resolves to whichever interpreter is first on PATH, which is this one.
#
# Pantogloss is on PyPI, so the default is simply its name and the release
# pip resolves is the one that arrives. Point PANTOGLOSS_SOURCE at a
# checkout, a wheel, or any other pip specifier to override that:
#   PANTOGLOSS_SOURCE=~/git/pantogloss bin/bigtranslate-setup
#
# The version is checked after installing rather than asked for in the
# specifier, because PANTOGLOSS_SOURCE is often a working checkout that pip
# has no version to resolve against. What it lands on is whatever that
# checkout is on, which is worth knowing -- and an editable checkout reports
# the version in its pyproject, which can trail the release it contains.
#
# 1.0.0rc1 is the floor. It is the first Pantogloss that runs on native
# Windows: it reads process memory through a portable path instead of the
# Unix-only resource module, so a Windows translator node is possible at all
# rather than failing on import. It also drops nlcodec from the runtime
# dependencies, which has no Windows wheel, and stops TensorFlow printing a
# GPU warning and a shutdown traceback into the service log on every start.
#
# The floor it replaces was 0.19.0, for a reason that still holds and is now
# far below the floor: 0.19 admits concurrent callers on Apple silicon and
# serialises them into the model itself, combining those already waiting into
# one call. Before it, concurrent translate() calls shared one Keras model and
# one Metal execution context and MPSGraph aborted the process; 0.18.0 avoided
# that with a single inference slot, which was safe and left the queue far
# longer than the work it guarded. 0.19 also memory-maps the tokenizer caches,
# which takes a warm start from about 5.4s to about 0.2s.
PANTOGLOSS_REQUIRED=${PANTOGLOSS_REQUIRED:-1.0.0rc1}
# The name alone, so the extras are appended to it below and pip resolves the
# newest release. The floor is enforced afterwards either way.
PANTOGLOSS_SOURCE=${PANTOGLOSS_SOURCE:-pantogloss}
# pip will not resolve a pre-release unless it is asked to, so a pre-release
# floor has to carry that permission with it: without --pre, asking for
# "pantogloss" while 1.0.0rc1 is the newest thing on PyPI installs 0.25.0
# instead, and the floor check below then reports it TOO OLD -- a setup that
# says what is wrong but cannot fix it by running again.
#
# Derived from the floor rather than set separately, so the two cannot
# disagree. It stays a floor and not a pin: with --pre, pip takes the newest
# pantogloss including later pre-releases, which is what every other version
# of this has done.
PANTOGLOSS_PRE=""
case "$PANTOGLOSS_REQUIRED" in
    *[!0-9.]*) PANTOGLOSS_PRE="--pre" ;;
esac
if [ -n "$PANTOGLOSS_SOURCE" ]; then
    echo
    echo "Installing Pantogloss from $PANTOGLOSS_SOURCE"
    # With its [server] extra, which is fastapi and uvicorn.
    #
    # "pantogloss serve" keeps one translator loaded behind a local HTTP API,
    # which is how the translate step avoids reloading the model for every
    # invocation -- about thirty seconds each time. Installed plain, serve
    # exists as a subcommand and fails with "No module named 'uvicorn'" the
    # moment it is asked to run, which is a poor way to find out.
    #
    # A specifier the extra cannot be appended to -- a URL, a wheel path --
    # is installed as given and the extra requested separately, so the
    # server half arrives either way.
    # On Apple silicon, with the Metal plugin.
    #
    # Pantogloss declares a [metal] extra -- tensorflow-metal -- and without
    # it TensorFlow sees no GPU at all, so --device auto has nothing to
    # choose and every translation runs on the CPU. That is not a fallback
    # anyone asked for; it is just what happens when the plugin is missing,
    # and it is invisible unless somebody reads /info and notices the backend.
    # The GPU extra for this machine, if there is one to have.
    #
    # Pantogloss ships two: [metal] for Apple silicon and [cuda] for Linux
    # with an NVIDIA card. Without whichever applies, TensorFlow sees no GPU
    # at all, so --device auto has nothing to choose and every translation
    # runs on the CPU -- invisibly, unless somebody reads /info and notices
    # the backend.
    #
    # The CUDA extra pulls a large stack, so it is asked for only when there
    # is a card to use it: nvidia-smi answering is the cheapest reliable sign
    # of a usable driver, and a machine without one gets the CPU build rather
    # than a gigabyte of libraries it cannot use.
    EXTRAS=server
    case "$(uname -s)" in
        Darwin)
            if [ "$(uname -m)" = "arm64" ]; then
                EXTRAS="server,metal"
                echo "  Apple silicon: including the Metal extra"
            else
                echo "  Intel Mac: no GPU extra (Metal needs Apple silicon)"
            fi
            ;;
        Linux)
            if command -v nvidia-smi > /dev/null 2>&1 && nvidia-smi > /dev/null 2>&1; then
                EXTRAS="server,cuda"
                echo "  NVIDIA GPU found: including the CUDA extra"
            else
                echo "  No usable NVIDIA GPU (nvidia-smi did not answer);"
                echo "  installing the CPU build. Set PANTOGLOSS_EXTRAS=server,cuda"
                echo "  to force it."
            fi
            ;;
        *)
            echo "  $(uname -s): no GPU extra known for this platform"
            ;;
    esac
    # The last word, for a machine this guessed wrong about.
    if [ -n "${PANTOGLOSS_EXTRAS:-}" ]; then
        EXTRAS="$PANTOGLOSS_EXTRAS"
        echo "  PANTOGLOSS_EXTRAS is set: using [$EXTRAS]"
    fi

    # --upgrade, and not only --pre.
    #
    # The floor is deliberately not in the specifier -- see above -- so what
    # pip is asked for is a bare name with no version, and an already-installed
    # Pantogloss of any age satisfies that. --pre widens which versions pip may
    # *choose*; it does not make pip reconsider a requirement it thinks is
    # already met. On a venv holding 0.25.0 the install printed "Requirement
    # already satisfied: pantogloss (0.25.0)", changed nothing, and the floor
    # check below then reported it TOO OLD. Setup ran to completion and left
    # the machine exactly as it found it.
    #
    # An empty venv hides this completely, which is how it shipped: there,
    # every install is an install. The case that matters is the one every real
    # machine is in.
    #
    # pip's default --upgrade-strategy is only-if-needed, so this moves
    # Pantogloss and only the dependencies that have to move with it --
    # measured on the running venv, --pre --upgrade changed one package.
    #
    # $PANTOGLOSS_PRE is unquoted on purpose. Empty, it has to expand to no
    # argument at all; quoted, it expands to one empty argument and pip exits
    # with "Invalid requirement: ''".
    case "$PANTOGLOSS_SOURCE" in
        *"["*"]"*)
            "$VENV_BIN/python" -m pip install --upgrade $PANTOGLOSS_PRE "$PANTOGLOSS_SOURCE"
            ;;
        *://*|*.whl|*.tar.gz)
            "$VENV_BIN/python" -m pip install --upgrade $PANTOGLOSS_PRE "$PANTOGLOSS_SOURCE"
            "$VENV_BIN/python" -m pip install "fastapi>=0.115,<1" "uvicorn>=0.34,<1"
            ;;
        *)
            "$VENV_BIN/python" -m pip install --upgrade $PANTOGLOSS_PRE \
                "${PANTOGLOSS_SOURCE}[${EXTRAS}]" \
                || {
                    echo "  extras not available; installing plain"
                    "$VENV_BIN/python" -m pip install --upgrade $PANTOGLOSS_PRE \
                        "$PANTOGLOSS_SOURCE"
                    "$VENV_BIN/python" -m pip install "fastapi>=0.115,<1" "uvicorn>=0.34,<1"
                }
            ;;
    esac
fi

echo
echo "Done. Installed:"
if "$VENV_BIN/python" -c "import pantogloss" > /dev/null 2>&1; then
    # Said here rather than left to fail at run time.
    installed=$("$VENV_BIN/python" -c \
        "import importlib.metadata as m; print(m.version('pantogloss'))" 2>/dev/null)
    if [ -n "$installed" ]; then
        # Enough of PEP 440 to order a pre-release below the release it leads
        # to. The obvious reading -- keep the digits of each dotted piece and
        # throw the letters away -- gets 1.0.0rc1 wrong twice: it reads the 1
        # of "rc1" as the patch number, making it (1, 0, 1), and then sorts it
        # *above* the finished 1.0.0. Every 1.0.0 that ever ships would be
        # reported TOO OLD against an rc floor. packaging.version would do this
        # properly, but it is not a dependency here and pip's copy is vendored
        # and not ours to import, so this is the subset that matters: release
        # numbers, then a pre-release marker ranked a < b < rc < released.
        if "$VENV_BIN/python" - "$installed" "$PANTOGLOSS_REQUIRED" <<'VERSION'
import re
import sys

PRE = {"a": 0, "alpha": 0, "b": 1, "beta": 1, "c": 2, "rc": 2, "pre": 2,
       "preview": 2}


def key(v):
    m = re.match(r"v?(\d+(?:\.\d+)*)[-_.]?([a-z]+)?[-_.]?(\d*)",
                 v.strip().lower())
    if not m:
        return ((0, 0, 0), (1,))
    release = [int(piece) for piece in m.group(1).split(".")][:3]
    while len(release) < 3:
        release.append(0)
    tag = m.group(2)
    if tag in PRE:
        return (tuple(release), (0, PRE[tag], int(m.group(3) or 0)))
    # No marker, or a .post/.dev suffix this does not rank: read it as the
    # release itself, which keeps an unrecognised suffix from failing a floor
    # the version plainly clears.
    return (tuple(release), (1,))


sys.exit(0 if key(sys.argv[1]) >= key(sys.argv[2]) else 1)
VERSION
        then
            echo "  pantogloss $installed"
        else
            echo "  pantogloss $installed  TOO OLD, wanted $PANTOGLOSS_REQUIRED or"
            echo "                    later. Below 1.0.0rc1 the server imports the"
            echo "                    Unix-only resource module and does not start"
            echo "                    on Windows at all; below 0.19.0 it cannot"
            echo "                    batch concurrent callers into one model call,"
            echo "                    so on Apple silicon it runs one translation"
            echo "                    at a time."
            if [ -n "$PANTOGLOSS_PRE" ]; then
                # The likeliest way to land here: pip was asked for a name, the
                # floor is a pre-release, and --pre never reached the install.
                echo "                    $PANTOGLOSS_REQUIRED is a pre-release, which pip"
                echo "                    installs only when asked. This script asks"
                echo "                    for it; a hand-run pip needs --pre."
            fi
            echo "                    Check out v$PANTOGLOSS_REQUIRED or later in"
            echo "                    \$PANTOGLOSS_SOURCE and run this again."
        fi
    fi
    if "$VENV_BIN/python" -c "import uvicorn, fastapi" > /dev/null 2>&1; then
        echo "  pantogloss serve  (the translation service)"
        # Said here, because the alternative is finding out from a run that
        # took as long as it always did.
        # Whether a GPU will actually be used, asked of TensorFlow itself
        # rather than inferred from what was installed. This is the answer
        # that matters and it is one line to get.
        gpus=$("$VENV_BIN/python" -c \
            "import tensorflow as tf; print(len(tf.config.list_physical_devices('GPU')))" \
            2>/dev/null)
        if [ "${gpus:-0}" -gt 0 ] 2>/dev/null; then
            echo "  GPU               $gpus visible to TensorFlow"
        else
            echo "  GPU               NONE visible to TensorFlow -- translation"
            echo "                    will run on the CPU whatever"
            echo "                    PANTOGLOSS_DEVICE says."
        fi
    else
        echo "  pantogloss serve  NOT AVAILABLE -- no fastapi/uvicorn."
        echo "                    The translate step will load the model per"
        echo "                    invocation instead of using the service."
    fi
else
    echo "  pantogloss  NOT INSTALLED -- the translate step will fail."
    echo "              Re-run with PANTOGLOSS_SOURCE set to a checkout or wheel."
fi
echo
echo "Restart the services so they pick the tools up:"
echo "  $BIGTRANSLATE_HOME/bin/oodt restart"
