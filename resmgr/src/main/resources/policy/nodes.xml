<!--
  The machines that may run a translate chunk.

  Each node runs a batch stub, which is what actually instantiates the
  workflow task; the resource manager only decides which stub gets the job.
  Capacity is how many jobs a node will take at once, and it is the node's
  Pantogloss concurrency rather than its core count: a chunk spends its life
  waiting on the translation service, so more jobs than the service has
  inference slots simply queue inside the service instead of outside it.

  BIGTRANSLATE_NODE_URL and BIGTRANSLATE_NODE2_URL are set per deployment,
  so a single-machine install needs no edit here: the second node simply
  goes unset and unused.
-->
<cas:nodes xmlns:cas="http://oodt.jpl.nasa.gov/1.0/resource">
  <node nodeId="local" ip="[BIGTRANSLATE_NODE_URL]" capacity="8" envReplace="true"/>
  <node nodeId="gpu" ip="[BIGTRANSLATE_NODE2_URL]" capacity="8" envReplace="true"/>
</cas:nodes>
